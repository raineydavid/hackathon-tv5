# TMDB API Configuration
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# AI/LLM Configuration (for natural language processing)
# Note: At least ONE of the following is required for AI features to work
# The system will automatically fallback to available models

# OpenAI API - For GPT models (optional but recommended for redundancy)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Generative AI (Gemini) - For advanced AI features including video audio interaction
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# RuVector Configuration (embedded vector database)
# Storage path for persistent vector database (defaults to ./data/media-vectors.db)
RUVECTOR_STORAGE_PATH=./data/media-vectors.db

# GCP Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# Database (Firestore)
FIRESTORE_PROJECT_ID=your_gcp_project_id

# Feature Flags
ENABLE_PREFERENCE_LEARNING=true
ENABLE_ARW_DISCOVERY=true
ENABLE_VIDEO_PLAYER=true
ENABLE_GEMINI_AUDIO=true

# Model Fallback System
# The app will automatically select the best available model based on API keys
# Check /api/ai-diagnostics endpoint for current configuration and recommendations
